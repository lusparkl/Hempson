# Copy to .env (never commit .env). Nothing auto-loads it: pnpm exec tsx --env-file=.env apps/api/src/index.ts
# Every line is optional; the values shown are the code defaults. Uncomment only what you change or what a feature needs.
# Where the SQLite DB (and the frozen adapter's browser profiles and locks) live. Keep OUTSIDE the repo,
# on an encrypted disk, excluded from cloud backup. Apply migrations with: pnpm migrate
# HEPSON_DATA_DIR=~/.hepson
# HEPSON_DB_FILE=~/.hepson/hepson.db
# HEPSON_HOST=127.0.0.1
# HEPSON_PORT=8787
# HEPSON_LOG_LEVEL=info
# Longest message text accepted from users and sent by the agent.
# HEPSON_MAX_MESSAGE_LENGTH=1000
# Dev/mock routes under /v1/dev (turn off in production).
# HEPSON_ENABLE_DEV_ROUTES=true
# Dashboard users (Feature 2). Self-registration only creates a user, never shop access.
# HEPSON_ALLOW_REGISTRATION=true
# HEPSON_SESSION_TTL_DAYS=30
# Sales agent (Feature 6). Inactive unless BOTH are set; then each shop owner still has to switch it on (PUT /v1/shops/:id/ai).
# Secret: set in the real environment / .env, never commit. Keep the value alone on its line (no trailing comment).
# OPENAI_API_KEY=
# A chat-completions model with tool calling that your account can use. Tested: gpt-5.4-nano (cheap, works), gpt-4o-mini, gpt-4.1-mini. NOT gpt-5-nano (reasoning eats the output budget, empty replies); gpt-4.1-nano is deprecated.
# HEPSON_OPENAI_MODEL=gpt-5.4-nano
# HEPSON_OPENAI_BASE_URL=https://api.openai.com/v1
# Telegram notifications (Feature 8). One shared bot; each shop owner sets its own chat via PUT /v1/shops/:id/notifications.
# Secret: set in the real environment / .env, never commit. Without it nothing is sent to Telegram.
# HEPSON_TELEGRAM_BOT_TOKEN=
# HEPSON_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Website chat (Feature 10). Public base URL of this API as shown in the widget snippet (default http://HOST:PORT).
# HEPSON_PUBLIC_URL=https://api.example.com
# Set true ONLY behind a reverse proxy you control (visitor rate limits use the client IP from X-Forwarded-For).
# HEPSON_TRUST_PROXY=false
# Abuse limits (defaults shown).
# HEPSON_WEBCHAT_SESSIONS_PER_IP_HOUR=20
# HEPSON_WEBCHAT_MESSAGES_PER_SESSION_MINUTE=10
# HEPSON_WEBCHAT_MESSAGES_PER_IP_MINUTE=40
# HEPSON_WEBCHAT_DAILY_MESSAGES_PER_SHOP=2000
# HEPSON_WEBCHAT_SESSION_DAYS=30

# Per-shop credentials (D28). Required before any integration token can be stored; without it those routes are disabled.
# Generate once with: pnpm gen-master-key. Keep it OUTSIDE the repo, the data dir and backups. Losing it makes every stored token unrecoverable.
# HEPSON_MASTER_KEY=
# HEPSON_MASTER_KEY_VERSION=1
# Rotation only: new key above (version +1), old key here, then `pnpm rewrap-credentials`, then remove these two.
# HEPSON_MASTER_KEY_PREVIOUS=
# HEPSON_MASTER_KEY_PREVIOUS_VERSION=

# Instagram API with Unified login (D23, D29). Webhooks and the connect flow are off unless the four values below are set (and HEPSON_MASTER_KEY).
# The Meta app's own App ID and App secret (App settings > Basic), NOT an Instagram app id. The secret signs webhooks and exchanges the login code; never commit it.
# HEPSON_META_APP_ID=
# HEPSON_META_APP_SECRET=
# Id of the Facebook Login for Business configuration (Use cases > Manage messaging & content on Instagram > API setup with Unified login > Configure your app). Not a secret.
# HEPSON_META_CONFIG_ID=
# Any random string; paste the same value into the Meta app's webhook "Verify token" field.
# HEPSON_META_VERIFY_TOKEN=
# Meta app webhook callback URL: <HEPSON_PUBLIC_URL>/webhooks/instagram ; redirect URL (saved in the configuration): <HEPSON_PUBLIC_URL>/public/instagram/callback
# Where the browser lands after connecting (the dashboard). Default: HEPSON_PUBLIC_URL.
# HEPSON_DASHBOARD_URL=http://127.0.0.1:5174
# HEPSON_META_API_VERSION=v26.0
# Polling intake through the Conversations API every N seconds (0 = off). Development uses it while Meta delivers no webhooks (D30); later a 60-120 s safety net. One Graph call per connected shop per run.
# HEPSON_INSTAGRAM_POLL_SECONDS=0

# Nova Poshta (P4): each shop enters its own API key in the dashboard. Tracking of shipped orders every N minutes (0 = off).
# HEPSON_NOVA_POSHTA_POLL_MINUTES=60
# HEPSON_NOVA_POSHTA_BASE_URL=https://api.novaposhta.ua/v2.0/json/

# Monobank payment links (P5): each shop enters its own acquiring token in the dashboard (needs HEPSON_MASTER_KEY).
# Webhooks need an https HEPSON_PUBLIC_URL; without one, payments are found only by the periodic status check.
# Every N minutes: status of open invoices, payment deadlines and reminders (0 = off).
# HEPSON_PAYMENT_CHECK_MINUTES=5

# Plans (P7): plan of a shop the operator has not assigned one (trial 100, starter 1000, growth 3000, business 10000
# AI replies per UTC month, or unlimited). Assign per shop with PUT /v1/shops/:shopId/plan and the admin key.
# HEPSON_DEFAULT_PLAN=starter
# HEPSON_MONOBANK_BASE_URL=https://api.monobank.ua

# Outbound allow-list additions (comma separated hosts). Built in: OpenAI, Instagram, Telegram, Nova Poshta, Monobank, WayForPay.
# HEPSON_EGRESS_EXTRA_HOSTS=

# Phase 1 connector (/v1/accounts: mock and the frozen browser adapter, D22). Shop features ignore these.
# HEPSON_ENABLE_BROWSER_ADAPTER=false
# HEPSON_POLL_INTERVAL_MS=20000
# HEPSON_RETENTION_DAYS=30
# HEPSON_MAX_CONVERSATIONS_PER_SYNC=30
# Emit message.received for pre-existing history on the first sync.
# HEPSON_BACKFILL_EVENTS=false
# Reopen saved sessions of enabled accounts at boot (never prompts for login).
# HEPSON_AUTOSTART=true
# HEPSON_MAX_BROWSERS=3
# Headed (visible) is REQUIRED for owner login. Headless is for automated tests only.
# HEPSON_BROWSER_HEADLESS=false
# HEPSON_INSTAGRAM_BASE_URL=https://www.instagram.com
# HEPSON_LOGIN_WAIT_MS=600000
